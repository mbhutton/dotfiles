#!/bin/bash

set -e # -e: exit on error

function fail {
  echo "$*" >&2
  exit 1
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MERMAID_DIR="$(dirname "$SCRIPT_DIR")"
EXEC_PATH="$MERMAID_DIR/node_modules/.bin/mmdc"
[[ -x "$EXEC_PATH" ]] || fail "Executable not found: $EXEC_PATH (hint: mh-install)"
"$EXEC_PATH" "$@"
