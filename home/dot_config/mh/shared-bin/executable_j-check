@dataclass
class Commit:
    commit_id: str
    change_id: str
    parent_commit_ids: list[str]

    # TODO: pull in all of https://github.com/jj-vcs/jj/blob/main/docs/templates.md#commit-type
    # TODO: pull in all of https://github.com/jj-vcs/jj/blob/main/docs/templates.md#commitref-type

    """
    commit ref:


    commit type:



Commit type

This type cannot be printed. The following methods are defined.

.description() -> String
.trailers() -> List<Trailer>
.change_id() -> ChangeId
.commit_id() -> CommitId
.parents() -> List<Commit>
.author() -> Signature
.committer() -> Signature
.signature() -> Option<CryptographicSignature>
.mine() -> Boolean: Commits where the author's email matches the email of the current user.
.working_copies() -> String: For multi-workspace repository, indicate working-copy commit as <workspace name>@.
.current_working_copy() -> Boolean: True for the working-copy commit of the current workspace.
.bookmarks() -> List<CommitRef>: Local and remote bookmarks pointing to the commit. A tracking remote bookmark will be included only if its target is different from the local one.
.local_bookmarks() -> List<CommitRef>: All local bookmarks pointing to the commit.
.remote_bookmarks() -> List<CommitRef>: All remote bookmarks pointing to the commit.
.tags() -> List<CommitRef>
.git_refs() -> List<CommitRef>
.git_head() -> Boolean: True for the Git HEAD commit.
.divergent() -> Boolean: True if the commit's change id corresponds to multiple visible commits.
.hidden() -> Boolean: True if the commit is not visible (a.k.a. abandoned).
.immutable() -> Boolean: True if the commit is included in the set of immutable commits.
.contained_in(revset: String) -> Boolean: True if the commit is included in the provided revset.
.conflict() -> Boolean: True if the commit contains merge conflicts.
.empty() -> Boolean: True if the commit modifies no files.
.diff([files: String]) -> TreeDiff: Changes from the parents within the files expression. All files are compared by default, but it is likely to change in future version to respect the command line path arguments.
.root() -> Boolean: True if the commit is the root commit.

    CommitRef type

The following methods are defined.

.name() -> RefSymbol: Local bookmark or tag name.
.remote() -> Option<RefSymbol>: Remote name if this is a remote ref.
.present() -> Boolean: True if the ref points to any commit.
.conflict() -> Boolean: True if the bookmark or tag is conflicted.
.normal_target() -> Option<Commit>: Target commit if the ref is not conflicted and points to a commit.
.removed_targets() -> List<Commit>: Old target commits if conflicted.
.added_targets() -> List<Commit>: New target commits. The list usually contains one "normal" target.
.tracked() -> Boolean: True if the ref is tracked by a local ref. The local ref might have been deleted (but not pushed yet.)
.tracking_present() -> Boolean: True if the ref is tracked by a local ref, and if the local ref points to any commit.
.tracking_ahead_count() -> SizeHint: Number of commits ahead of the tracking local ref.
.tracking_behind_count() -> SizeHint: Number of commits behind of the tracking local ref.
    """

    is_conflicted: bool
    is_empty: bool
    has_description: bool

    # Parent commits, matching order of parent_commit_ids, Nothing if parent not in graph
    cached_parent_refs: list[Union["Commit", None]] = None

    def has_ancestor(self, other: "Commit") -> bool:
        """Check if this commit has the given commit as an ancestor."""
        if self.commit_id == other.commit_id:
            return True
        for parent in self.cached_parent_refs or []:
            if parent and parent.has_ancestor(other):
                return True
        return False


@dataclass
class CommitGraph:
    commits_by_id: dict[str, Commit]


def populate_commit_graph(commits: list[Commit]) -> CommitGraph:
    commits_by_id = {c.commit_id: c for c in commits}

    for commit in commits:
        commit.cached_parent_refs = [
            commits_by_id.get(parent_id) for parent_id in commit.parent_commit_ids
        ]

    return CommitGraph(commits_by_id=commits_by_id)


def fail(msg) -> SystemExit:
    """Prints an error message to stderr and exits with code 1.
    Callers can 'raise fail(...)' rather than 'fail(...)' to work around type checking issues.
    """
    print(msg, file=sys.stderr)
    sys.exit(1)
    # noinspection PyUnreachableCode
    return SystemExit(1)


def call_command_or_fail(command: list[str], failure_message: str) -> str:
    if not command:
        raise fail("Command list cannot be empty.")
    if not failure_message:
        raise fail("Failure message cannot be empty.")
    try:
        result = subprocess.run(command, check=True, text=True, capture_output=True)
        return result.stdout.strip()
    except subprocess.CalledProcessError:
        raise fail(failure_message)


def get_repo_home_dir() -> str:
    repo_dir = call_command_or_fail(
        ["git", "rev-parse", "--show-toplevel"], "Not inside a git repository."
    )
    if not repo_dir:
        raise fail("No repository home directory found.")
    if not os.path.isdir(repo_dir):
        raise fail(f"Repository home directory does not exist: {repo_dir}")
    if not os.path.isdir(os.path.join(repo_dir, ".git")):
        raise fail(
            f"Repository home directory is not a valid git repository: {repo_dir}"
        )
    if not os.path.isdir(os.path.join(repo_dir, ".jj")):
        raise fail(
            f"Repository home directory is not a valid jj repository: {repo_dir}"
        )
    return repo_dir


def get_local_tags() -> list[str]:
    return call_command_or_fail(
        ["git", "tag", "--list"], "Failed to get local tags."
    ).splitlines()


def get_local_branches() -> list[str]:
    return call_command_or_fail(
        ["git", "branch", "--format=%(refname:short)"], "Failed to get local branches."
    ).splitlines()


if __name__ == "__main__":
